{
  "_doc": "Yatırım tavsiyesi / hedef fiyat / kesinlik dili kalıpları (harness/action_guard.py okur). KOD DEĞİL VERİ: kalıp eklemek için yalnızca bu dosya değişir. lang=tr kalıpları tr_lower(metin) üzerinde (küçük harf, İ->i, I->ı), lang=en kalıpları özgün metinde (IGNORECASE; case_sensitive=true ise büyük/küçük harf duyarlı) çalışır. Her kuralın positive/negative örnekleri tests/harness/test_action_guard.py tarafından çalıştırılır: positive => bu kural yakalar, negative => hiçbir kural yakalamaz. category: BUY_SELL (al/sat emri) | PRICE_TARGET (hedef fiyat) | CERTAINTY (kesinlik/garanti).",
  "version": 1,
  "rules": [
    {"id": "TR_BUY_IMPERATIVE", "lang": "tr", "category": "BUY_SELL",
     "pattern": "(?<!\\w)(?<!dikkate\\s)(?<!hesaba\\s)(?<!ele\\s)(?<!baz\\s)(?<!not\\s)(?<!kabul\\s)(?<!göz önüne\\s)(?<!göz önünde\\s)(?:alın(?!\\s+(?:teri|yazısı))|alınız|almalısınız|almalısın|almanızı)(?!\\w)",
     "positive": ["Bu hisseyi alın.", "Mutlaka ALINIZ", "Hisseyi almalısınız.", "Almanızı öneririm.", "Hisseyi alın, alın teri değil."],
     "negative": ["alt Bollinger bandına dokunuldu", "Talep arttı.", "alınan karar", "Karar alındı.", "kâr alımı yapıldı",
                  "Bu riski dikkate alın.", "Kurulumu dikkate alınız.", "Bunu göz önüne alın.", "Hesaba alın.", "Konuyu ele alın.",
                  "Baz alın.", "Alın teri döktü.", "ALIN TERİ", "Alın yazısı böyleymiş."]},
    {"id": "TR_BUY_SATIN_AL", "lang": "tr", "category": "BUY_SELL",
     "pattern": "(?<!\\w)satın\\s+al(?:ın|ınız|malısınız|abilirsiniz)?(?!\\w)",
     "positive": ["Hisseyi satın alın.", "Bence satın al.", "Satın almalısınız."],
     "negative": ["satın alma gücü paritesi", "satın alım sözleşmesi imzalandı", "şirketi satın aldı"]},
    {"id": "TR_SELL_IMPERATIVE", "lang": "tr", "category": "BUY_SELL",
     "pattern": "(?<!\\w)(?:satın(?!\\w)(?!\\s+al)|satınız|satmalısınız|satmalısın|satmanızı)(?!\\w)",
     "positive": ["Elinizdekini satın.", "Hisseyi satmalısınız.", "Satmanızı öneririm."],
     "negative": ["satış gelirleri yükseldi", "Hisseler satıldı.", "satıcı baskısı", "satın alma gücü"]},
    {"id": "TR_RECOMMENDATION", "lang": "tr", "category": "BUY_SELL",
     "pattern": "(?<!\\w)(?:(?:al|sat)\\s+(?:tavsiye|öneri)\\w*|(?:alım|satım|satış)\\s+(?:tavsiye\\w*|öneri\\w*|fırsatı)|portföyünüze\\s+ekleyin|pozisyonu?\\s+(?:açın|artırın|azaltın|kapatın))",
     "positive": ["AL tavsiyesi veriyorum.", "Burada bir alım fırsatı var.", "Portföyünüze ekleyin.", "Pozisyonu artırın."],
     "negative": ["alım satım hacmi arttı", "al-sat sinyalleri değerlendirildi", "pozisyon büyüklüğü hesaplandı"]},
    {"id": "TR_TARGET_PRICE", "lang": "tr", "category": "PRICE_TARGET",
     "pattern": "(?<!\\w)(?:hedef\\s+fiyat(?!sız)\\w*|fiyat\\s+hedef\\w*)",
     "positive": ["THYAO için hedef fiyat 350 TL.", "Hedef fiyatı yükseltildi.", "Fiyat hedefi belirlendi."],
     "negative": ["hedef sektör perakende", "hedef grup", "fiyat hareketi zayıf", "hedef fiyatsız bir analiz", "Hedef fiyatsız kalındı."]},
    {"id": "TR_TARGET_NUMBER", "lang": "tr", "category": "PRICE_TARGET",
     "pattern": "(?<!\\w)hedef(?:imiz|im|i)?\\s*[:=]?\\s*\\d[\\d.,]*\\s*(?:tl|₺|lira)|\\d[\\d.,]*\\s*(?:tl|₺)['’]?\\w*\\s+(?:hedef\\w*|seviyesine)|\\d[\\d.,]*\\s*(?:tl|₺)['’]?(?:ye|ya|e|a)\\s+(?:çıkar|ulaş|yüksel)\\w*",
     "positive": ["Hedefimiz 350 TL.", "350 TL'ye çıkar.", "400 TL seviyesine ulaşır."],
     "negative": ["kapanış 299,25 TL'ye geriledi", "hedef 5 gün içinde kapanma", "299,25 TL civarında işlem gördü"]},
    {"id": "TR_CERTAIN_MOVE", "lang": "tr", "category": "CERTAINTY",
     "pattern": "(?<!\\w)(?:kesin(?:likle)?|mutlaka|şüphesiz)\\s+(?:yüksel|artar|artış|çıkar|çıkacak|kazan|kazandır|düşer|düşecek|düşüş)\\w*",
     "positive": ["Hisse kesin yükselir.", "Kesinlikle yükselecek.", "Mutlaka kazandırır.", "Fiyat KESİN ARTAR.", "Kesinlikle yükselmedi."],
     "negative": ["kesin sonuç yoktur", "Kesin değildir.", "kesin olarak ölçülemedi", "mutlaka kontrol edin"]},
    {"id": "TR_GUARANTEE", "lang": "tr", "category": "CERTAINTY",
     "pattern": "(?<!\\w)garanti(?!['’]|\\s+(?:bankası|bbva|faktoring|emeklilik|bank))\\w*",
     "positive": ["Kazanç garantidir.", "Garantili getiri.", "Yükseliş garantisi var."],
     "negative": ["Garanti Bankası'nın bilançosu açıklandı", "Garanti BBVA hisseleri", "Garanti'nin kârı arttı"]},
    {"id": "EN_MODAL_ADVICE", "lang": "en", "category": "BUY_SELL",
     "pattern": "\\b(?:should|must|ought\\s+to|need\\s+to|recommend(?:ed)?(?:\\s+(?:to|that\\s+you))?|advise[sd]?(?:\\s+to)?|suggest(?:ed)?(?:\\s+to)?|time\\s+to)\\s+(?:buy|sell|accumulate)(?:ing)?\\b",
     "positive": ["You should buy THYAO now.", "I recommend buying.", "It is time to sell."],
     "negative": ["the benchmark buy-and-hold strategy", "positions should be sized by the harness", "buyback programme announced", "sell-side analysts"]},
    {"id": "EN_IMPERATIVE", "lang": "en", "category": "BUY_SELL", "flags": ["M"],
     "pattern": "(?:^|(?<=[.!?:;]\\s))(?:buy|sell)(?![\\w-])(?!\\s+and\\s+hold)",
     "positive": ["Buy THYAO now.", "Result. Sell immediately.", "Sell"],
     "negative": ["Buy-and-hold returned 12 percent.", "Buy and hold is the benchmark.", "Sellers dominated the session."]},
    {"id": "EN_RATING", "lang": "en", "category": "BUY_SELL",
     "pattern": "\\b(?:strong\\s+(?:buy|sell)|(?:buy|sell)\\s+(?:rating|recommendation))\\b",
     "positive": ["This is a strong buy.", "We issue a sell recommendation."],
     "negative": ["the buy and hold benchmark", "BUY_AND_HOLD benchmark"]},
    {"id": "EN_RATING_UPPER", "lang": "en", "category": "BUY_SELL", "case_sensitive": true,
     "pattern": "\\b(?:BUY|SELL)\\b(?![_-])(?!\\s+AND\\s+HOLD)",
     "positive": ["Rating: BUY", "Action: SELL now"],
     "negative": ["BUY_AND_HOLD benchmark", "BUY AND HOLD benchmark", "BUY-AND-HOLD benchmark", "the buyer"]},
    {"id": "EN_PRICE_TARGET", "lang": "en", "category": "PRICE_TARGET",
     "pattern": "\\b(?:price\\s+targets?|target\\s+price)\\b",
     "positive": ["The price target is 350.", "Our target price is high."],
     "negative": ["the target sector is retail", "price action was weak"]},
    {"id": "EN_GUARANTEE", "lang": "en", "category": "CERTAINTY",
     "pattern": "\\bguarantee[sd]?\\b|\\brisk[-\\s]free\\b|\\bcan(?:'|’)?t\\s+lose\\b|\\bsure\\s+thing\\b",
     "positive": ["Guaranteed returns.", "It is a sure thing.", "A risk-free trade.", "You can't lose."],
     "negative": ["past results are historical", "the guarantor is unknown"]},
    {"id": "EN_CERTAIN_MOVE", "lang": "en", "category": "CERTAINTY",
     "pattern": "\\b(?:will\\s+(?:definitely|certainly|surely|absolutely)|(?:is|are)\\s+(?:certain|sure|bound)\\s+to)\\s+(?:rise|go\\s+up|increase|climb|soar|surge|fall|drop|decline)\\b",
     "positive": ["It will definitely rise.", "The stock is certain to go up."],
     "negative": ["it may rise or fall", "the price will be reviewed"]}
  ],
  "refusal_markers": [
    {"lang": "tr", "pattern": "(?<!\\w)(?:veremem|vermiyorum|vermem|verilemez|verilmez|verilmemekte\\w*|verilmiyor|veremiyorum|sunamam|sunmuyorum|sunulamaz|paylaşamam|paylaşmıyorum|yapamam|yapmıyorum|yapılamaz|edilemez|edilmez|etmez|etmiyor)(?!\\w)"},
    {"lang": "tr", "pattern": "(?<!\\w)garanti\\w*\\s+(?:değil|yok|vermez|vermiyor|sunmaz|içermez|etmez)\\w*"},
    {"lang": "tr", "pattern": "(?<!\\w)demek\\s+değil\\w*"},
    {"lang": "en", "pattern": "\\b(?:cannot|can't|can\\s?not|won't|will\\s+not|do\\s+not|don't|am\\s+not\\s+able\\s+to|unable\\s+to|refuse\\s+to)\\s+(?:\\w+\\s+)?(?:give|provide|offer|issue|make|state|share)\\b"},
    {"lang": "en", "pattern": "\\b(?:no\\s+guarantee\\w*|not\\s+guaranteed|cannot\\s+be\\s+guaranteed|can't\\s+be\\s+guaranteed)\\b"}
  ],
  "refutation_markers": [
    {"lang": "tr", "pattern": "(?<!\\w)(?:doğrulanmam\\w*|doğrulanmad\\w*|doğrulanamam\\w*|doğrulanamad\\w*|doğrulanamaz\\w*|doğrulanmıyor\\w*)",
     "examples": ["doğrulanmamıştır", "doğrulanmamaktadır", "doğrulanmadı", "doğrulanamamıştır", "doğrulanamadı", "doğrulanamaz", "doğrulanmıyor"]},
    {"lang": "tr", "pattern": "(?<!\\w)(?:kanıtlanmam\\w*|kanıtlanmad\\w*|kanıtlanamam\\w*|kanıtlanamad\\w*|kanıtlanamaz\\w*)",
     "examples": ["kanıtlanmamıştır", "kanıtlanmamaktadır", "kanıtlanmadı", "kanıtlanamamıştır", "kanıtlanamadı", "kanıtlanamaz"]},
    {"lang": "tr", "pattern": "(?<!\\w)(?:desteklenmi\\w*|desteklenme\\w*|desteklemi\\w*|desteklemez\\w*)",
     "examples": ["desteklenmemektedir", "desteklenmiyor", "desteklenmemiştir", "desteklemiyor", "desteklemez"]},
    {"lang": "tr", "pattern": "(?<!\\w)(?:asılsız\\w*|dayanaksız\\w*|temelsiz\\w*)",
     "examples": ["asılsızdır", "dayanaksızdır", "temelsizdir"]},
    {"lang": "tr", "pattern": "(?<!\\w)kanıt\\w*\\s+yok\\w*",
     "examples": ["kanıt yoktur", "kanıtı yok"]},
    {"lang": "en", "pattern": "\\b(?:unverified|unproven|unsupported|unfounded|not\\s+verified|not\\s+supported|not\\s+proven|no\\s+evidence|cannot\\s+be\\s+(?:verified|confirmed)|can't\\s+be\\s+(?:verified|confirmed))\\b",
     "examples": ["unverified", "unproven", "unsupported", "not verified", "no evidence", "cannot be verified"]}
  ],
  "negation_after": [
    {"lang": "tr", "pattern": "(?<!\\w)değil\\w*"}
  ],
  "negation_before": [
    {"lang": "en", "pattern": "(?:\\bnot|n't|\\bnever)\\s*$"}
  ],
  "claim_nouns": [
    {"lang": "tr", "pattern": "(?<!\\w)iddia\\w*",
     "examples": ["iddiası", "iddiaları", "iddiasının", "iddiasını", "iddiasına", "iddia", "iddialar"]},
    {"lang": "tr", "pattern": "(?<!\\w)ifade\\w*",
     "examples": ["ifadesi", "ifadesinin", "ifadesini", "ifadesine", "ifade", "ifadeler"]},
    {"lang": "tr", "pattern": "(?<!\\w)söylem\\w*",
     "examples": ["söylemi", "söyleminin", "söylemini", "söylemine", "söylem", "söylemler"]},
    {"lang": "tr", "pattern": "(?<!\\w)(?:beklenti|varsayım)\\w*",
     "examples": ["beklentisi", "varsayımı"]},
    {"lang": "en", "pattern": "\\b(?:claims?|assertions?|statements?|assumptions?)\\b",
     "examples": ["claim", "claims", "assertion", "statement", "assumption"]}
  ],
  "question_advice": [
    {"lang": "tr", "pattern": "(?<!\\w)(?:alayım|satayım|alsam|satsam)(?!\\w)",
     "examples": ["Yarın EREGL alayım mı?", "THYAO'yu satayım mı?", "Alsam mı?"]},
    {"lang": "tr", "pattern": "(?<!\\w)(?:almalı|satmalı)\\s+mı(?:yım|yız)?(?!\\w)",
     "examples": ["THYAO'yu almalı mıyım?", "Satmalı mıyım?"]},
    {"lang": "tr", "pattern": "(?<!\\w)(?:alınır|satılır|alınmalı|satılmalı)\\s+mı(?!\\w)",
     "examples": ["Bu hisse alınır mı?", "Satılır mı?"]},
    {"lang": "tr", "pattern": "(?<!\\w)(?:yatırım\\s+)?tavsiye\\w*",
     "examples": ["Bana yatırım tavsiyesi verir misin?", "Tavsiye ver."]},
    {"lang": "en", "pattern": "\\bshould\\s+i\\s+(?:buy|sell|hold)\\b|\\b(?:buy|sell)\\s+or\\s+(?:buy|sell|hold)\\b|\\bworth\\s+buying\\b|\\binvestment\\s+advice\\b",
     "examples": ["Should I buy THYAO now?", "Buy or sell?", "Is it worth buying?", "Give me investment advice."]}
  ]
}
